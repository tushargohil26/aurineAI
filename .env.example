# Aurine AI Assistant - Configuration

# AI Provider: aurine (local Ollama, free, no key), ollama (remote Ollama),
#               google, openai, groq, deepseek, anthropic
AI_PROVIDER=aurine

# --- Local Ollama (default, free, works offline) ---
# Install Ollama: https://ollama.com  then run:
#   ollama pull qwen2.5-coder:7b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Aurine custom models (create from Modelfile / Modelfile-native):
#   ollama create aurine-coder -f Modelfile
#   ollama create aurine-native -f Modelfile-native
AURINE_NATIVE_MODEL=qwen2.5-coder:7b
AURINE_EMBEDDING_MODEL=nomic-embed-text

# --- NEXUS SERVER (share Aurine with all your devices) ---
# Start the server on 0.0.0.0:8000 so other devices on the network can connect:
#   python auracode.py --nexus        (or: auracode.bat --nexus)
# Port used by --nexus mode:
# NEXUS_PORT=8000

# --- Cloud Providers (optional, fallback) ---
# Get free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.0-flash
# https://console.groq.com/keys
GROQ_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Email verification (optional; used for OTP login) ---
# Leave blank for dev mode: OTP codes are logged to {DATA_DIR}/otp_codes.log
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Aurine <no-reply@aurine.local>
OTP_TTL_SECONDS=600

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (persist these volumes in production)
VECTOR_DB=./vector_store.sqlite3
DATA_DIR=./data
